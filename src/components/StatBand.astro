---
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---
<div class="stat-band">
  {stats.map((s) => (
    <div class="stat-cell">
      <div class="stat-value mono">{s.value}</div>
      <div class="stat-label">{s.label}</div>
    </div>
  ))}
</div>

<style>
  .stat-band { display: flex; flex-wrap: wrap; background: var(--navy); }
  .stat-cell {
    flex: 1; min-width: 150px; padding: 22px 24px; border-right: 1px solid rgba(255,255,255,0.08);
  }
  .stat-cell:last-child { border-right: none; }
  .stat-value { font-size: 22px; font-weight: 600; color: #fff; }
  .stat-label { font-size: 11.5px; color: rgba(255,255,255,0.5); margin-top: 4px; }
  @media (max-width: 640px) {
    .stat-cell { padding: 16px 14px; min-width: 44%; }
    .stat-value { font-size: 18px; }
  }
</style>
