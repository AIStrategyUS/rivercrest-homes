---
interface Row {
  label: string;
  agent: string;
  us: string;
}
interface Props {
  rows: Row[];
  variant?: 'teaser' | 'full';
}
const { rows, variant = 'full' } = Astro.props;
const visibleRows = variant === 'teaser' ? rows.slice(0, 5) : rows;
---
<div class="cmp-table reveal">
  <div class="cmp-head">
    <div></div>
    <div>Traditional Agent</div>
    <div class="cmp-us-head">Us</div>
  </div>
  {visibleRows.map((r) => (
    <div class="cmp-row">
      <div class="cmp-label">{r.label}</div>
      <div class="cmp-agent">{r.agent}</div>
      <div class="cmp-us">{r.us}</div>
    </div>
  ))}
</div>

<style>
  .cmp-table { border-radius: 14px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 6px 32px rgba(14,27,51,0.08); }
  .cmp-head { display: grid; grid-template-columns: 1.8fr 1fr 1fr; background: var(--navy); }
  .cmp-head div { padding: 14px 14px; text-align: center; font-family: var(--font-mono); font-size: 10.5px; color: rgba(255,255,255,0.4); letter-spacing: 0.05em; text-transform: uppercase; }
  .cmp-us-head { background: var(--forest); color: #fff !important; letter-spacing: 0 !important; font-weight: 700; font-size: 11.5px !important; }
  .cmp-row { display: grid; grid-template-columns: 1.8fr 1fr 1fr; background: var(--white); border-bottom: 1px solid var(--border); }
  .cmp-row:last-child { border-bottom: none; }
  .cmp-row > div { padding: 13px 12px; font-size: 13px; display: flex; align-items: center; justify-content: center; text-align: center; }
  .cmp-label { justify-content: flex-start !important; text-align: left !important; font-weight: 600; padding-left: 18px !important; font-size: 13.5px; }
  .cmp-agent { color: var(--slate-lt); font-family: var(--font-mono); }
  .cmp-us { background: var(--forest-lt); color: var(--forest-dk); font-weight: 700; font-family: var(--font-mono); font-size: 12px; }
</style>
