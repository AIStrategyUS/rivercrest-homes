---
interface Props {
  title: string;
  lastUpdated: string;
}
const { title, lastUpdated } = Astro.props;
---
<div class="legal-hero">
  <h1>{title}</h1>
  <p>Last updated: {lastUpdated}</p>
</div>
<div class="legal-wrap">
  <slot />
</div>

<style>
  .legal-hero {
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
    padding: 148px 24px 60px; text-align: center;
  }
  .legal-hero h1 { color: #fff; margin-bottom: 12px; font-size: clamp(28px, 4.4vw, 42px); }
  .legal-hero p { font-size: 13.5px; color: var(--slate-lt); }

  .legal-wrap { max-width: 780px; margin: 0 auto; padding: 52px 24px 90px; }
  .legal-wrap :global(h2) {
    font-size: 22px; font-weight: 700; color: var(--navy); margin: 38px 0 14px; padding-top: 6px;
  }
  .legal-wrap :global(h2:first-child) { margin-top: 0; }
  .legal-wrap :global(h3) { font-size: 15.5px; font-weight: 600; color: var(--navy); margin: 22px 0 10px; }
  .legal-wrap :global(p) { font-size: 14.5px; line-height: 1.85; color: var(--slate); margin-bottom: 14px; }
  .legal-wrap :global(ul) { margin: 0 0 14px 22px; }
  .legal-wrap :global(li) { font-size: 14.5px; line-height: 1.85; color: var(--slate); margin-bottom: 8px; }
  .legal-wrap :global(a) { color: var(--forest); font-weight: 500; }
  .legal-wrap :global(strong) { color: var(--navy); font-weight: 600; }
  .legal-wrap :global(.callout) { margin: 20px 0; }
  .legal-wrap :global(.callout p) { margin-bottom: 0; color: var(--navy); }
</style>
