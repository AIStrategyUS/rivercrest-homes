---
interface Props {
  ctaHref?: string;
}
const { ctaHref = '/contact/#get-offer' } = Astro.props;
const links = [
  { href: '/how-it-works/', label: 'How It Works' },
  { href: '/compare/', label: 'Compare' },
  { href: '/situations/', label: 'Situations' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
];
---

<nav>
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="TN Home Cash Offer home">
      <img
        src="/images/logo-192.png"
        alt="TN Home Cash Offer"
        width="192"
        height="192"
        class="nav-logo"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>

    <div class="nav-right">
      <a href="tel:6293430888" class="nav-phone">629-343-0888</a>
      <a href={ctaHref} class="nav-cta">Get My Offer &rarr;</a>
      <button id="menu-btn" class="menu-btn" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
    <a href="tel:6293430888">Call 629-343-0888</a>
    <a href={ctaHref} class="mobile-cta">Get My Cash Offer &rarr;</a>
  </div>
</nav>

<style>
  /* Light header: the TN Home Cash Offer logo is navy + green on white, so it
     needs a light ground to show in its real colors. */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 999;
    background: #fff;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 2px 18px rgba(14,27,51,0.07);
  }
  .nav-inner {
    max-width: var(--container); margin: 0 auto; padding: 0 24px; height: 80px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .nav-brand { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
  .nav-logo { width: 66px; height: 66px; display: block; }
  .nav-links { display: flex; align-items: center; gap: 26px; }
  .nav-links a {
    font-size: 13.5px; font-weight: 500; color: var(--slate); text-decoration: none;
    transition: color 0.15s; white-space: nowrap;
  }
  .nav-links a:hover { color: var(--navy); }
  .nav-right { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .nav-phone {
    font-family: var(--font-mono); font-size: 13px; font-weight: 500; color: var(--navy); text-decoration: none;
    white-space: nowrap;
  }
  .nav-phone:hover { color: var(--forest-dk); }
  .nav-cta {
    background: var(--forest); color: #fff; padding: 10px 20px; border-radius: 6px;
    font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap;
    transition: background 0.2s, transform 0.15s;
  }
  .nav-cta:hover { background: var(--forest-dk); transform: translateY(-1px); }

  .menu-btn {
    display: none; flex-direction: column; gap: 4px; background: none; border: none; cursor: pointer; padding: 8px;
  }
  .menu-btn span { width: 22px; height: 2px; background: var(--navy); border-radius: 2px; }

  .mobile-menu {
    display: none; flex-direction: column; gap: 2px; padding: 8px 20px 20px;
    background: #fff; border-top: 1px solid var(--border);
  }
  .mobile-menu a {
    padding: 13px 4px; color: var(--navy); text-decoration: none; font-size: 15px; font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu .mobile-cta {
    margin-top: 12px; background: var(--forest); color: #fff; text-align: center; border-radius: 8px;
    border-bottom: none; font-weight: 600;
  }
  nav.menu-open .mobile-menu { display: flex; }

  @media (max-width: 860px) {
    .nav-inner { height: 68px; }
    .nav-logo { width: 54px; height: 54px; }
    .nav-links, .nav-phone { display: none; }
    .menu-btn { display: flex; }
  }

  /* Below ~560px there isn't room for logo + CTA button + hamburger on one
     line without the hamburger getting pushed off-screen. The mobile menu
     already has its own prominent CTA, so drop the header one here. */
  @media (max-width: 560px) {
    .nav-cta { display: none; }
  }
</style>

<script>
  import { initMobileMenu } from '../scripts/mobile-menu.js';
  initMobileMenu();
</script>
