---
interface Props {
  ctaHref?: string;
}
const { ctaHref = '/contact/#get-offer' } = Astro.props;
const links = [
  { href: '/how-it-works/', label: 'How It Works' },
  { href: '/compare/', label: 'Compare' },
  { href: '/situations/', label: 'Situations' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
];
---

<nav>
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <svg class="nav-logo" viewBox="0 0 56 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <polygon points="10,30 22,8 34,30" fill="#7EC8A0" opacity="0.5"/>
        <polygon points="22,30 34,8 46,30" fill="#7EC8A0" opacity="0.5"/>
        <polygon points="14,30 28,3 42,30" fill="#7EC8A0" opacity="0.88"/>
        <polyline points="22,30 22,22 28,16 34,22 34,30" fill="none" stroke="#0E1B33" stroke-width="1.7" stroke-linejoin="round"/>
        <line x1="6" y1="30" x2="50" y2="30" stroke="#7EC8A0" stroke-width="1.2" opacity="0.6"/>
      </svg>
      <span>TN Home Cash Offer</span>
    </a>

    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>

    <div class="nav-right">
      <a href="tel:6293430888" class="nav-phone">629-343-0888</a>
      <a href={ctaHref} class="nav-cta">Get My Offer &rarr;</a>
      <button id="menu-btn" class="menu-btn" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
    <a href="tel:6293430888">Call 629-343-0888</a>
    <a href={ctaHref} class="mobile-cta">Get My Cash Offer &rarr;</a>
  </div>
</nav>

<style>
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 999;
    background: rgba(14,27,51,0.97); backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .nav-inner {
    max-width: var(--container); margin: 0 auto; padding: 0 24px; height: 64px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .nav-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
  .nav-logo { width: 30px; height: 26px; }
  .nav-brand span {
    font-family: var(--font-display); font-weight: 700; font-size: 16px; color: #fff; white-space: nowrap;
  }
  .nav-links { display: flex; align-items: center; gap: 26px; }
  .nav-links a {
    font-size: 13.5px; font-weight: 500; color: rgba(255,255,255,0.68); text-decoration: none;
    transition: color 0.15s; white-space: nowrap;
  }
  .nav-links a:hover { color: #fff; }
  .nav-right { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .nav-phone {
    font-family: var(--font-mono); font-size: 13px; color: rgba(255,255,255,0.72); text-decoration: none;
    white-space: nowrap;
  }
  .nav-phone:hover { color: #fff; }
  .nav-cta {
    background: var(--forest); color: #fff; padding: 10px 20px; border-radius: 6px;
    font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap;
    transition: background 0.2s, transform 0.15s;
  }
  .nav-cta:hover { background: var(--forest-dk); transform: translateY(-1px); }

  .menu-btn {
    display: none; flex-direction: column; gap: 4px; background: none; border: none; cursor: pointer; padding: 8px;
  }
  .menu-btn span { width: 20px; height: 2px; background: #fff; border-radius: 2px; }

  .mobile-menu {
    display: none; flex-direction: column; gap: 2px; padding: 10px 20px 20px;
    background: var(--navy); border-top: 1px solid rgba(255,255,255,0.07);
  }
  .mobile-menu a {
    padding: 12px 4px; color: rgba(255,255,255,0.78); text-decoration: none; font-size: 15px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .mobile-menu .mobile-cta {
    margin-top: 10px; background: var(--forest); color: #fff; text-align: center; border-radius: 8px;
    border-bottom: none; font-weight: 600;
  }
  nav.menu-open .mobile-menu { display: flex; }

  @media (max-width: 860px) {
    .nav-links, .nav-phone { display: none; }
    .menu-btn { display: flex; }
  }

  /* Below ~560px there isn't room for brand + CTA button + hamburger on one
     line without the hamburger getting pushed off-screen. The mobile menu
     already has its own prominent CTA, so drop the header one here. */
  @media (max-width: 560px) {
    .nav-cta { display: none; }
  }
</style>

<script>
  import { initMobileMenu } from '../scripts/mobile-menu.js';
  initMobileMenu();
</script>
