---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import GoodToKnow from '../../components/GoodToKnow.astro';
import SituationIcon from '../../components/SituationIcon.astro';
import { situations } from '../../data/situations.js';

export function getStaticPaths() {
  return situations.map((s) => ({
    params: { slug: s.slug },
    props: { situation: s },
  }));
}

const { situation } = Astro.props;
const seoTitles = {
  foreclosure: 'Stop Foreclosure: Sell Your House Fast | TN Home Cash Offer',
  'inherited-property': 'Sell an Inherited House in Tennessee | TN Home Cash Offer',
  divorce: 'Sell a House During a Divorce in Tennessee | TN Home Cash Offer',
  'major-repairs': 'Sell a Distressed House As-Is, Major Repairs Needed | TN Home Cash Offer',
  relocation: 'Sell Your Tennessee House Before Relocating | TN Home Cash Offer',
  'tired-landlord': 'Sell a Rental Property, Tenants and All | TN Home Cash Offer',
  'tax-liens-code-violations': 'Behind on Property Taxes or Facing Code Fines | TN Home Cash Offer',
  'vacant-property': "Sell a Vacant House You Can't Maintain | TN Home Cash Offer",
  'downsizing-estate': 'Downsizing or Settling an Estate in Tennessee | TN Home Cash Offer',
  'other-situations': 'Sell Your House in Any Situation | TN Home Cash Offer',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tnhomecashoffer.com/' },
    { '@type': 'ListItem', position: 2, name: 'Situations', item: 'https://tnhomecashoffer.com/situations/' },
    { '@type': 'ListItem', position: 3, name: situation.title, item: `https://tnhomecashoffer.com/situations/${situation.slug}/` },
  ],
};

const faqSchema = situation.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: situation.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const structuredData = faqSchema ? [breadcrumbSchema, faqSchema] : [breadcrumbSchema];
---

<Layout
  title={seoTitles[situation.slug] || `${situation.title} | TN Home Cash Offer`}
  description={situation.blurb}
  canonicalPath={`/situations/${situation.slug}/`}
  includeTurnstile={true}
  navCtaHref="#get-offer"
  structuredData={structuredData}
>
  <section class="sit-band">
    <div class="wrap sit-hero">
      <div>
        <div class="sit-badge reveal"><SituationIcon slug={situation.slug} /></div>
        <h1 class="reveal">{situation.heroHeadline}</h1>
        <p class="lede reveal" style="margin-bottom:22px;">{situation.heroSub}</p>
        <p class="lede reveal" style="margin-bottom:20px;">{situation.body}</p>
        {situation.goodToKnow && (
          <div class="reveal" style="margin-bottom:24px;">
            <GoodToKnow>{situation.goodToKnow}</GoodToKnow>
          </div>
        )}

        <h2 class="reveal" style="margin:28px 0 12px; font-size:18px;">How TN Home Cash Offer Solves This</h2>
        <ul class="solves-list reveal">
          {situation.solves.map((item) => <li>{item}</li>)}
        </ul>

        {situation.faq.length > 0 && (
          <div class="mini-faq reveal">
            <h2 style="font-size:18px; margin-bottom:12px;">Quick Questions</h2>
            {situation.faq.map((f) => (
              <div class="mini-faq-item">
                <p class="mfq-q">{f.q}</p>
                <p class="mfq-a">{f.a}</p>
              </div>
            ))}
          </div>
        )}

        <a href="#get-offer" class="btn btn-primary reveal" style="margin-top:16px;">{situation.ctaLabel}</a>
      </div>

      <div class="sit-form reveal">
        <LeadForm presetSituation={situation.dropdownValue} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .sit-band {
    padding: 148px 0 84px;
    background:
      radial-gradient(ellipse 45% 55% at 95% 0%, rgba(201,154,61,0.10) 0%, transparent 60%),
      var(--paper-sunk);
    border-bottom: 1px solid var(--border);
  }
  .sit-hero { display: grid; grid-template-columns: 1fr 400px; gap: 56px; align-items: start; }
  .sit-badge {
    width: 52px; height: 52px; border-radius: 13px; background: var(--forest-lt); color: var(--forest-dk);
    display: flex; align-items: center; justify-content: center; margin-bottom: 20px;
  }
  .sit-badge svg { width: 26px; height: 26px; }
  .solves-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 8px; }
  .solves-list li {
    font-size: 14.5px; color: var(--navy); padding-left: 26px; position: relative;
  }
  .solves-list li::before {
    content: '✓'; position: absolute; left: 0; top: 1px; width: 18px; height: 18px; border-radius: 50%;
    background: var(--forest); color: #fff; font-size: 10px; display: flex; align-items: center; justify-content: center;
  }
  .mini-faq { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--border); }
  .mini-faq-item { margin-bottom: 14px; }
  .mfq-q { font-weight: 600; font-size: 14px; margin-bottom: 3px; }
  .mfq-a { font-size: 13.5px; color: var(--slate); line-height: 1.65; }
  .sit-form { position: sticky; top: 88px; }

  @media (max-width: 900px) {
    .sit-band { padding: 120px 0 56px; }
    .sit-hero { grid-template-columns: 1fr; }
    .sit-form { position: static; }
  }
</style>
