---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | TN Home Cash Offer"
  description="This page doesn't exist. Here's how to get back on track."
  canonicalPath="/404/"
>
  <section class="section center" style="padding-top:150px; padding-bottom:120px;">
    <div class="wrap-narrow">
      <h1 style="margin-bottom:14px;">This Page Took a Wrong Turn.</h1>
      <p class="lede center" style="margin: 0 auto 28px;">
        Whatever you were looking for isn't here, but we're glad to help you find it.
      </p>
      <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn btn-ghost">Back to Home</a>
        <a href="/contact/#get-offer" class="btn btn-primary">Tell Us About Your House</a>
        <a href="/situations/" class="btn btn-ghost">Browse Situations</a>
      </div>
    </div>
  </section>
</Layout>
